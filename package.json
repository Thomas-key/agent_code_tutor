{
  "name": "agent-code-tutor",
  "displayName": "Agent Code Tutor",
  "description": "把编辑器暴露成 agent 可调用的 JSONL API，让agent教你写代码。",
  "version": "0.1.0",
  "publisher": "illusion",
  "repository": {
    "type": "git",
    "url": "https://github.com/Thomas-key/agent_code_tutor.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tutorApi.confirm",
        "title": "Tutor API: 继续(看完了)"
      },
      {
        "command": "tutorApi.abort",
        "title": "Tutor API: 暂停(撤回这一拍)"
      },
      {
        "command": "tutorApi.ask",
        "title": "Tutor API: 问这一行"
      },
      {
        "command": "tutorApi.askFile",
        "title": "Tutor API: 问这个文件"
      }
    ],
    "keybindings": [
      {
        "command": "tutorApi.confirm",
        "key": "ctrl+alt+enter",
        "when": "editorTextFocus"
      },
      {
        "command": "tutorApi.abort",
        "key": "ctrl+alt+backspace",
        "when": "editorTextFocus"
      },
      {
        "command": "tutorApi.ask",
        "key": "ctrl+alt+q",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Tutor API",
      "properties": {
        "tutorApi.conversationToken": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "会话身份。扩展启动时如果为空会自动生成一个并写回**工作区设置**。harness插件要带同一个值,推送才会发给它。改了这个,客户端那边也要跟着改。"
        },
        "tutorApi.port": {
          "type": "integer",
          "default": 41890,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "machine-overridable",
          "markdownDescription": "监听端口。默认 41890。**端口被占用时改这里**,并让 DSH 侧插件的 `port` 设置也改成同一个值 —— 两边连不上通常就是这个。"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "tutorApi.ask",
          "when": "editorTextFocus",
          "group": "1_modification"
        }
      ]
    }
  }
}
